# Copie para .env.local (dev) ou configure na Vercel (produção). NUNCA comitar valores reais.

# Token do App Privado do HubSpot (escopos: crm.objects.deals read+write, crm.objects.owners read)
HUBSPOT_TOKEN=

# Auth.js / NextAuth v5
AUTH_SECRET=            # gere com: npx auth secret
AUTH_GOOGLE_ID=         # Client ID do OAuth 2.0 (Aplicativo da Web)
AUTH_GOOGLE_SECRET=     # Client Secret

# Opcional: sobrescreve a lista de admins (CSV). Se ausente, usa o padrão em lib/config.js
# ADMIN_EMAILS=marcio.spagnolo@profissionaissa.com,crm.psa@profissionaissa.com
